<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>evolutionary_explorer_ros</name>
  <version>0.1.0</version>
  <description>
    SSC0712 - Trabalho 1: sistema de exploracao, navegacao e controle de missao
    com ROS 2 (Humble) e Gazebo Fortress. Um robo diferencial explora a arena,
    detecta a bandeira inimiga por visao (camera de segmentacao semantica),
    navega ate ela desviando de obstaculos com o LIDAR e se posiciona para a
    coleta, tudo coordenado por uma maquina de estados. A arquitetura foi
    projetada para, em um segundo momento, evoluir seus parametros com
    computacao evolutiva (todos os ganhos de comportamento ficam centralizados
    em config/mission_params.yaml).
  </description>
  <maintainer email="lazaropereiravn@gmail.com">lazaro</maintainer>
  <license>Apache-2.0</license>

  <!-- Dependencias de teste (padrao ament_python) -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <!-- Bibliotecas cliente e tipos de mensagem usados pelos nodos Python -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>

  <!-- Lancamento, simulacao e infraestrutura do robo -->
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>topic_tools</exec_depend>

  <!-- Gazebo Fortress (Ignition) + ros2_control -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ign_ros2_control</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <!-- Controle manual opcional do robo -->
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
